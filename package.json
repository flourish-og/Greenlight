{
  "name": "greenlight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Red -> agent -> Green. Nothing ships until Kane says so.",
  "scripts": {
    "dev": "pnpm --dir apps/store dev",
    "board": "pnpm --dir apps/board dev",
    "build": "pnpm --dir apps/store build && pnpm --dir apps/board build",
    "preview": "pnpm --dir apps/store preview",
    "test": "node --test \"tests/plugin/*.test.ts\"",
    "flows": "kane-cli testrun run --match \"^flows[/\\\\]store[/\\\\]\" --agent --headless",
    "flows:ratchet": "kane-cli testrun run --match \"^flows[/\\\\]store[/\\\\]\" --agent --headless --no-adaptive-heal",
    "flows:board": "kane-cli testrun run --match \"^flows[/\\\\]board[/\\\\]\" --agent --headless --no-adaptive-heal",
    "replay:record": "node scripts/record-replay.mjs"
  }
}
